FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 1) 先拷 SLN、所有项目文件、以及依赖相关配置
COPY ./MeetlyOmni.sln ./
COPY ./.config/NuGet.config ./.config/NuGet.config
COPY ./Directory.Packages.props ./Directory.Packages.props
COPY ./src/MeetlyOmni.Api/*.csproj ./src/MeetlyOmni.Api/
# 如果还有其他项目或共享项目，也要一并 COPY 它们的 csproj

# 2) 先还原（此时信息齐全，能完整还原）
RUN dotnet restore ./MeetlyOmni.sln

# 3) 再拷其余源码
COPY . .

# 4) 发布（此时可安全地使用 --no-restore）
RUN dotnet publish ./src/MeetlyOmni.Api/MeetlyOmni.Api.csproj -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 80
ENTRYPOINT ["dotnet", "MeetlyOmni.Api.dll"]