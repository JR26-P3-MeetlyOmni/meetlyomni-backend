{
  "family": "meetlyomniapi-task",
  "executionRoleArn": "arn:aws:iam::034362033405:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::034362033405:role/meetlyomniapi-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "app", // <— 容器名，下面要用到
      "image": "public.ecr/image", // 占位即可，稍后用 action 覆盖
      "essential": true,
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }]
    }
  ]
}

